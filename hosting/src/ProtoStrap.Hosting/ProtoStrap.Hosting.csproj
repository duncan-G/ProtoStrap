<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>ProtoStrap.Hosting</PackageId>
    <Version>0.1.3</Version>
    <Description>Describe a ProtoStrap application in an Aspire AppHost: the ProtoStrap environment, PublishAsProtoStrap* for each component, queues and files, and the protostrap-spec step that writes protostrap.yaml.</Description>
    <PackageTags>aspire;hosting;protostrap</PackageTags>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" Version="13.6.2" />
    <!-- PublishAsProtoStrapStateful fills in what these integrations know: the port, the data
         path and the dump command. -->
    <PackageReference Include="Aspire.Hosting.PostgreSQL" Version="13.6.2" />
    <PackageReference Include="Aspire.Hosting.Redis" Version="13.6.2" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ProtoStrap.Hosting.Tests" />
  </ItemGroup>

  <!-- ProtoStrapCheckout is the ProtoStrap checkout this assembly is built from, where the local
       edge builds protostrap when it isn't on PATH (ProtoStrapBinary.cs). A package's consumers
       don't have the checkout it was packed from, so packing leaves it out. -->
  <ItemGroup Condition="'$(_IsPacking)' != 'true'">
    <AssemblyMetadata Include="ProtoStrapCheckout" Value="$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../../..'))" />
  </ItemGroup>

</Project>
